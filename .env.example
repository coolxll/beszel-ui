# Point this at your Beszel hub. The browser talks to this URL directly.
# Examples:
#   VITE_BESZEL_URL=http://100.85.194.78:8090     # Tailscale
#   VITE_BESZEL_URL=https://beszel.example.com    # public origin
VITE_BESZEL_URL=http://100.85.194.78:8090

# Optional. Service-account credentials baked into the JS bundle at build
# time. When set, the app auto-signs-in on startup and skips the login page.
# Use a PocketBase `users` record with role=readonly — anything baked in
# here is visible to anyone who can load the page.
# VITE_PB_EMAIL=beszel-ui@example.com
# VITE_PB_PASSWORD=replace-me
VITE_PB_EMAIL=
VITE_PB_PASSWORD=

# Optional. JSON map from system name / host / info.h to ISO 3166-1 alpha-2
# country code. Used to render a flag emoji next to the system name. Leave
# empty to disable flags.
# VITE_SYSTEM_FLAGS={"rn-direct":"cn","corp172-dev":"cn","ddrk":"us"}
VITE_SYSTEM_FLAGS=

# Optional. Set to "true" to skip login and render the UI with mock data
# (visual review only; no backend calls are made).
# VITE_NO_AUTH=true
